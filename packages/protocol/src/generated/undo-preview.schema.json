{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UndoPreview",
  "type": "object",
  "properties": {
    "affected": {
      "$ref": "#/$defs/Counter"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OperationConflict"
      },
      "maxItems": 1000
    },
    "errorCode": {
      "$ref": "#/$defs/RequiredNullable"
    },
    "expectedRevision": {
      "$ref": "#/$defs/Counter"
    },
    "operationId": {
      "$ref": "#/$defs/Id"
    },
    "profileId": {
      "$ref": "#/$defs/Id"
    },
    "sourceEpoch": {
      "$ref": "#/$defs/SourceEpoch"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OperationStep"
      },
      "maxItems": 1000
    },
    "writable": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "profileId",
    "sourceEpoch",
    "operationId",
    "expectedRevision",
    "writable",
    "affected",
    "errorCode",
    "steps",
    "conflicts"
  ],
  "$defs": {
    "BookmarkNode": {
      "type": "object",
      "properties": {
        "chromeId": {
          "$ref": "#/$defs/Id"
        },
        "dateAdded": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "dateLastUsed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "folderType": {
          "anyOf": [
            {
              "$ref": "#/$defs/FolderType"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "title": {
          "$ref": "#/$defs/Title"
        },
        "unmodifiable": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unmodifiable"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Url"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "chromeId",
        "position",
        "kind",
        "title"
      ]
    },
    "Counter": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "EditField": {
      "type": "string",
      "enum": [
        "title",
        "url",
        "parent",
        "position",
        "order",
        "existence"
      ]
    },
    "ErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "INVALID_MESSAGE",
            "UNSUPPORTED_VERSION",
            "FRAME_TOO_LARGE",
            "LIMIT_EXCEEDED",
            "INVALID_TREE",
            "UNPAIRED",
            "READ_ONLY",
            "WRONG_PROFILE",
            "STALE_PROPOSAL",
            "PROTECTED_NODE",
            "UNCERTAIN_WRITE",
            "FETCH_DENIED",
            "INVALID_AI_OUTPUT",
            "STORAGE_ERROR",
            "STORAGE_NEWER_SCHEMA",
            "MIGRATION_FAILED",
            "CONFLICT",
            "CANCELLED"
          ]
        },
        {
          "description": "The selected Chrome directory is missing, unreadable, or not a User Data directory.",
          "type": "string",
          "const": "PATH_UNAVAILABLE"
        }
      ]
    },
    "FolderType": {
      "type": "string",
      "enum": [
        "bookmarks-bar",
        "other",
        "mobile",
        "managed"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "Mutation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "create"
            },
            "parentId": {
              "$ref": "#/$defs/Id"
            },
            "position": {
              "$ref": "#/$defs/Position"
            },
            "title": {
              "$ref": "#/$defs/Title"
            },
            "url": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Url"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "parentId",
            "position",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "update"
            },
            "title": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Title"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Url"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "move"
            },
            "parentId": {
              "$ref": "#/$defs/Id"
            },
            "position": {
              "$ref": "#/$defs/Position"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "parentId",
            "position"
          ]
        },
        {
          "type": "object",
          "properties": {
            "childIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 100000
            },
            "kind": {
              "type": "string",
              "const": "reorder"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "childIds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "delete"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "NodeKind": {
      "type": "string",
      "enum": [
        "folder",
        "bookmark"
      ]
    },
    "OperationConflict": {
      "type": "object",
      "properties": {
        "chromeId": {
          "$ref": "#/$defs/RequiredNullable2"
        },
        "field": {
          "$ref": "#/$defs/EditField"
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "chromeId",
        "field"
      ]
    },
    "OperationStep": {
      "type": "object",
      "properties": {
        "expectedBefore": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookmarkNode"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedChildIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 100000
        },
        "expectedSubtree": {
          "description": "Optional reviewed subtree for daily grouped move/delete operations.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/BookmarkNode"
          },
          "maxItems": 100000,
          "minItems": 1
        },
        "payload": {
          "$ref": "#/$defs/Mutation"
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "payload"
      ]
    },
    "Position": {
      "type": "integer",
      "format": "uint64",
      "maximum": 100000,
      "minimum": 0
    },
    "RequiredNullable": {
      "description": "A required JSON field whose value can be null. Unlike Option, absence is rejected.",
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "RequiredNullable2": {
      "description": "A required JSON field whose value can be null. Unlike Option, absence is rejected.",
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "SourceEpoch": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1
    },
    "SourceTime": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/TimeSource"
        },
        "unixMillis": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "unixMillis"
      ]
    },
    "TimeSource": {
      "type": "string",
      "enum": [
        "chrome_api",
        "chrome_file"
      ]
    },
    "Title": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 0
    },
    "Unmodifiable": {
      "type": "string",
      "enum": [
        "managed"
      ]
    },
    "Url": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 1
    }
  }
}
