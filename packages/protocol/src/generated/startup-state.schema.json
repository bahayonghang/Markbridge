{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StartupState",
  "description": "Foundation IPC state. Task 02 owns the paired transport protocol.",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "integer",
      "format": "uint8",
      "maximum": 1,
      "minimum": 1
    },
    "state": {
      "$ref": "#/$defs/StartupConnection"
    }
  },
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "state"
  ],
  "$defs": {
    "StartupConnection": {
      "type": "string",
      "enum": [
        "unpaired"
      ]
    }
  }
}
