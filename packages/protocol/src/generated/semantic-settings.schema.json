{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticSettings",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "endpointLabel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "inputRecipeVersion": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "maxInputBytes": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "maxInputChars": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "model": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  },
  "additionalProperties": false,
  "required": [
    "enabled",
    "endpointLabel",
    "model",
    "inputRecipeVersion",
    "maxInputChars",
    "maxInputBytes"
  ]
}
