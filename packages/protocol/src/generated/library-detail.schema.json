{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LibraryDetail",
  "description": "One node from a cache `get` read, with ancestor titles nearest-root first.",
  "type": "object",
  "properties": {
    "ancestors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Title"
      },
      "maxItems": 256
    },
    "node": {
      "$ref": "#/$defs/BookmarkNode"
    }
  },
  "additionalProperties": false,
  "required": [
    "node",
    "ancestors"
  ],
  "$defs": {
    "BookmarkNode": {
      "type": "object",
      "properties": {
        "chromeId": {
          "$ref": "#/$defs/Id"
        },
        "dateAdded": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "dateLastUsed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "folderType": {
          "anyOf": [
            {
              "$ref": "#/$defs/FolderType"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "title": {
          "$ref": "#/$defs/Title"
        },
        "unmodifiable": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unmodifiable"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Url"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "chromeId",
        "position",
        "kind",
        "title"
      ]
    },
    "Counter": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "FolderType": {
      "type": "string",
      "enum": [
        "bookmarks-bar",
        "other",
        "mobile",
        "managed"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "NodeKind": {
      "type": "string",
      "enum": [
        "folder",
        "bookmark"
      ]
    },
    "Position": {
      "type": "integer",
      "format": "uint64",
      "maximum": 100000,
      "minimum": 0
    },
    "SourceTime": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/TimeSource"
        },
        "unixMillis": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "unixMillis"
      ]
    },
    "TimeSource": {
      "type": "string",
      "enum": [
        "chrome_api",
        "chrome_file"
      ]
    },
    "Title": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 0
    },
    "Unmodifiable": {
      "type": "string",
      "enum": [
        "managed"
      ]
    },
    "Url": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 1
    }
  }
}
