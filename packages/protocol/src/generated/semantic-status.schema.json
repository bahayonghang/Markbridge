{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticStatus",
  "type": "object",
  "properties": {
    "index": {
      "$ref": "#/$defs/RequiredNullable"
    },
    "settings": {
      "$ref": "#/$defs/SemanticSettings"
    }
  },
  "additionalProperties": false,
  "required": [
    "settings",
    "index"
  ],
  "$defs": {
    "Counter": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "RequiredNullable": {
      "description": "A required JSON field whose value can be null. Unlike Option, absence is rejected.",
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticIndex"
        },
        {
          "type": "null"
        }
      ]
    },
    "RequiredNullable2": {
      "description": "A required JSON field whose value can be null. Unlike Option, absence is rejected.",
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "RequiredNullable3": {
      "description": "A required JSON field whose value can be null. Unlike Option, absence is rejected.",
      "anyOf": [
        {
          "$ref": "#/$defs/SemanticFailure"
        },
        {
          "type": "null"
        }
      ]
    },
    "SemanticFailure": {
      "type": "string",
      "enum": [
        "DISABLED",
        "ENDPOINT_DENIED",
        "MISSING_MODEL",
        "REMOTE_MODEL",
        "DIMENSION_MISMATCH",
        "INVALID_VECTOR",
        "MODEL_CHANGED",
        "STALE_INDEX",
        "CANCELLED",
        "TIMED_OUT",
        "UNREACHABLE",
        "INVALID_RESPONSE",
        "LIMIT_EXCEEDED",
        "STORAGE_ERROR"
      ]
    },
    "SemanticIndex": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/RequiredNullable2"
        },
        "dimension": {
          "type": [
            "integer",
            "null"
          ],
          "maximum": 4096,
          "minimum": 1
        },
        "failure": {
          "$ref": "#/$defs/RequiredNullable3"
        },
        "failureMessage": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "generation": {
          "$ref": "#/$defs/Counter"
        },
        "indexId": {
          "$ref": "#/$defs/Id"
        },
        "model": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "pending": {
          "type": "integer",
          "format": "uint16",
          "maximum": 10000,
          "minimum": 0
        },
        "phase": {
          "$ref": "#/$defs/SemanticPhase"
        },
        "profileId": {
          "$ref": "#/$defs/Id"
        },
        "ready": {
          "type": "integer",
          "format": "uint16",
          "maximum": 10000,
          "minimum": 0
        },
        "sourceEpoch": {
          "$ref": "#/$defs/SourceEpoch"
        },
        "storedBytes": {
          "$ref": "#/$defs/Counter"
        },
        "total": {
          "type": "integer",
          "format": "uint16",
          "maximum": 10000,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "indexId",
        "profileId",
        "sourceEpoch",
        "generation",
        "phase",
        "model",
        "digest",
        "dimension",
        "total",
        "ready",
        "pending",
        "storedBytes",
        "failure",
        "failureMessage"
      ]
    },
    "SemanticPhase": {
      "type": "string",
      "enum": [
        "running",
        "paused",
        "ready",
        "failed",
        "stale"
      ]
    },
    "SemanticSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpointLabel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "inputRecipeVersion": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "maxInputBytes": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "maxInputChars": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "endpointLabel",
        "model",
        "inputRecipeVersion",
        "maxInputChars",
        "maxInputBytes"
      ]
    },
    "SourceEpoch": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 1
    }
  }
}
