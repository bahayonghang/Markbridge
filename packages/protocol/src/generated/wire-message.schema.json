  "$defs": {
    "ApplyPayload": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "$ref": "#/$defs/Counter"
        },
        "operationId": {
          "$ref": "#/$defs/Id"
        },
        "sourceEpoch": {
          "$ref": "#/$defs/SourceEpoch"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationStep"
          },
          "maxItems": 1000,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "operationId",
        "sourceEpoch",
        "expectedRevision",
        "steps"
      ]
    },
    "BookmarkEvent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "created"
            },
            "node": {
              "$ref": "#/$defs/BookmarkNode"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "node"
          ]
        },
        {
          "type": "object",
          "properties": {
            "chromeId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "type": "string",
              "const": "changed"
            },
            "title": {
              "$ref": "#/$defs/Title"
            },
            "url": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Url"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "chromeId",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "chromeId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "type": "string",
              "const": "moved"
            },
            "oldParentId": {
              "$ref": "#/$defs/Id"
            },
            "oldPosition": {
              "$ref": "#/$defs/Position"
            },
            "parentId": {
              "$ref": "#/$defs/Id"
            },
            "position": {
              "$ref": "#/$defs/Position"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "chromeId",
            "oldParentId",
            "oldPosition",
            "parentId",
            "position"
          ]
        },
        {
          "type": "object",
          "properties": {
            "chromeId": {
              "$ref": "#/$defs/Id"
            },
            "kind": {
              "type": "string",
              "const": "removed"
            },
            "parentId": {
              "$ref": "#/$defs/Id"
            },
            "position": {
              "$ref": "#/$defs/Position"
            },
            "subtree": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BookmarkNode"
              },
              "maxItems": 100000
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "chromeId",
            "parentId",
            "position",
            "subtree"
          ]
        },
        {
          "type": "object",
          "properties": {
            "childIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 100000
            },
            "kind": {
              "type": "string",
              "const": "reordered"
            },
            "parentId": {
              "$ref": "#/$defs/Id"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "parentId",
            "childIds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "import_began"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "import_ended"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "BookmarkNode": {
      "type": "object",
      "properties": {
        "chromeId": {
          "$ref": "#/$defs/Id"
        },
        "dateAdded": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "dateLastUsed": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "folderType": {
          "anyOf": [
            {
              "$ref": "#/$defs/FolderType"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "title": {
          "$ref": "#/$defs/Title"
        },
        "unmodifiable": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unmodifiable"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/Url"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "chromeId",
        "position",
        "kind",
        "title"
      ]
    },
    "Counter": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "Credential": {
      "type": "string",
      "maxLength": 1024,
      "minLength": 32
    },
    "DisplayName": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "EmptyPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "ErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "INVALID_MESSAGE",
            "UNSUPPORTED_VERSION",
            "FRAME_TOO_LARGE",
            "LIMIT_EXCEEDED",
            "INVALID_TREE",
            "UNPAIRED",
            "READ_ONLY",
            "WRONG_PROFILE",
            "STALE_PROPOSAL",
            "PROTECTED_NODE",
            "UNCERTAIN_WRITE",
            "FETCH_DENIED",
            "INVALID_AI_OUTPUT",
            "STORAGE_ERROR",
            "STORAGE_NEWER_SCHEMA",
            "MIGRATION_FAILED",
            "CONFLICT",
            "CANCELLED"
          ]
        },
        {
          "description": "The selected Chrome directory is missing, unreadable, or not a User Data directory.",
          "type": "string",
          "const": "PATH_UNAVAILABLE"
        }
      ]
    },
    "EventPayload": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/BookmarkEvent"
        },
        "sourceEpoch": {
          "$ref": "#/$defs/SourceEpoch"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceEpoch",
        "event"
      ]
    },
    "FolderType": {
      "type": "string",
      "enum": [
        "bookmarks-bar",
        "other",
        "mobile",
        "managed"
      ]
    },
    "HelloPayload": {
      "type": "object",
      "properties": {
        "credential": {
          "$ref": "#/$defs/Credential"
        },
        "instanceId": {
          "$ref": "#/$defs/Id"
        }
      },
      "additionalProperties": false,
      "required": [
        "instanceId",
        "credential"
      ]
    },
    "HelloResultPayload": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "errorCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceEpoch": {
          "$ref": "#/$defs/SourceEpoch"
        }
      },
      "additionalProperties": false,
      "required": [
        "accepted",
        "sourceEpoch"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "Mutation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "create"
            },
            "parentId": {
              "$ref": "#/$defs/Id"
            },
            "position": {
              "$ref": "#/$defs/Position"
            },
            "title": {
              "$ref": "#/$defs/Title"
            },
            "url": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Url"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "parentId",
            "position",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "update"
            },
            "title": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Title"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Url"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "move"
            },
            "parentId": {
              "$ref": "#/$defs/Id"
            },
            "position": {
              "$ref": "#/$defs/Position"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "parentId",
            "position"
          ]
        },
        {
          "type": "object",
          "properties": {
            "childIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "maxItems": 100000
            },
            "kind": {
              "type": "string",
              "const": "reorder"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "childIds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "delete"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "NodeKind": {
      "type": "string",
      "enum": [
        "folder",
        "bookmark"
      ]
    },
    "OperationState": {
      "type": "string",
      "enum": [
        "planned",
        "applying",
        "applied",
        "uncertain",
        "partial",
        "failed",
        "rolling_back",
        "rolled_back",
        "rollback_conflict"
      ]
    },
    "OperationStep": {
      "type": "object",
      "properties": {
        "expectedBefore": {
          "anyOf": [
            {
              "$ref": "#/$defs/BookmarkNode"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedChildIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Id"
          },
          "maxItems": 100000
        },
        "expectedSubtree": {
          "description": "Optional reviewed subtree for daily grouped move/delete operations.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/BookmarkNode"
          },
          "maxItems": 100000,
          "minItems": 1
        },
        "payload": {
          "$ref": "#/$defs/Mutation"
        },
        "requestId": {
          "$ref": "#/$defs/Id"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "requestId",
        "payload"
      ]
    },
    "PairPayload": {
      "type": "object",
      "properties": {
        "credential": {
          "$ref": "#/$defs/Credential"
