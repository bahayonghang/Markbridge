{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosticSaveResult",
  "type": "object",
  "properties": {
    "errorCode": {
      "$ref": "#/$defs/RequiredNullable"
    },
    "status": {
      "$ref": "#/$defs/ExportSaveStatus"
    }
  },
  "additionalProperties": false,
  "required": [
    "status",
    "errorCode"
  ],
  "$defs": {
    "ErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "INVALID_MESSAGE",
            "UNSUPPORTED_VERSION",
            "FRAME_TOO_LARGE",
            "LIMIT_EXCEEDED",
            "INVALID_TREE",
            "UNPAIRED",
            "READ_ONLY",
            "WRONG_PROFILE",
            "STALE_PROPOSAL",
            "PROTECTED_NODE",
            "UNCERTAIN_WRITE",
            "FETCH_DENIED",
            "INVALID_AI_OUTPUT",
            "STORAGE_ERROR",
            "STORAGE_NEWER_SCHEMA",
            "MIGRATION_FAILED",
            "CONFLICT",
            "CANCELLED"
          ]
        },
        {
          "description": "The selected Chrome directory is missing, unreadable, or not a User Data directory.",
          "type": "string",
          "const": "PATH_UNAVAILABLE"
        }
      ]
    },
    "ExportSaveStatus": {
      "type": "string",
      "enum": [
        "saved",
        "cancelled",
        "failed"
      ]
    },
    "RequiredNullable": {
      "description": "A required JSON field whose value can be null. Unlike Option, absence is rejected.",
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
