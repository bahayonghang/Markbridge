{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatchEditStatus",
  "type": "object",
  "properties": {
    "errorCode": {
      "$ref": "#/$defs/RequiredNullable"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BatchItemResult"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "operationId": {
      "$ref": "#/$defs/Id"
    },
    "profileId": {
      "$ref": "#/$defs/Id"
    },
    "state": {
      "$ref": "#/$defs/OperationState"
    },
    "stopped": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "operationId",
    "profileId",
    "state",
    "stopped",
    "items",
    "errorCode"
  ],
  "$defs": {
    "BatchItemResult": {
      "type": "object",
      "properties": {
        "chromeId": {
          "$ref": "#/$defs/Id"
        },
        "errorCode": {
          "$ref": "#/$defs/RequiredNullable"
        },
        "state": {
          "$ref": "#/$defs/BatchItemState"
        },
        "title": {
          "$ref": "#/$defs/Title"
        }
      },
      "additionalProperties": false,
      "required": [
        "chromeId",
        "title",
        "state",
        "errorCode"
      ]
    },
    "BatchItemState": {
      "type": "string",
      "enum": [
        "applied",
        "not_executed",
        "in_flight",
        "conflict",
        "uncertain"
      ]
    },
    "ErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "INVALID_MESSAGE",
            "UNSUPPORTED_VERSION",
            "FRAME_TOO_LARGE",
            "LIMIT_EXCEEDED",
            "INVALID_TREE",
            "UNPAIRED",
            "READ_ONLY",
            "WRONG_PROFILE",
            "STALE_PROPOSAL",
            "PROTECTED_NODE",
            "UNCERTAIN_WRITE",
            "FETCH_DENIED",
            "INVALID_AI_OUTPUT",
            "STORAGE_ERROR",
            "STORAGE_NEWER_SCHEMA",
            "MIGRATION_FAILED",
            "CONFLICT",
            "CANCELLED"
          ]
        },
        {
          "description": "The selected Chrome directory is missing, unreadable, or not a User Data directory.",
          "type": "string",
          "const": "PATH_UNAVAILABLE"
        }
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "OperationState": {
      "type": "string",
      "enum": [
        "planned",
        "applying",
        "applied",
        "uncertain",
        "partial",
        "failed",
        "rolling_back",
        "rolled_back",
        "rollback_conflict"
      ]
    },
    "RequiredNullable": {
      "description": "A required JSON field whose value can be null. Unlike Option, absence is rejected.",
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "Title": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 0
    }
  }
}
