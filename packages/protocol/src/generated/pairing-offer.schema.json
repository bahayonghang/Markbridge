{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PairingOffer",
  "type": "object",
  "properties": {
    "expiresAt": {
      "$ref": "#/$defs/Counter"
    },
    "pairingCode": {
      "type": "string"
    },
    "profileId": {
      "$ref": "#/$defs/Id"
    }
  },
  "additionalProperties": false,
  "required": [
    "profileId",
    "pairingCode",
    "expiresAt"
  ],
  "$defs": {
    "Counter": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    }
  }
}
