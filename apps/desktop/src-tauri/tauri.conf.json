{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markbridge",
  "version": "0.1.0",
  "identifier": "com.markbridge.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Markbridge · 签桥", "width": 1100, "height": 760, "minWidth": 640, "minHeight": 480 }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"], "macOS": { "minimumSystemVersion": "14.0" } }
}
