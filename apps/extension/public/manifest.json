{
  "manifest_version": 3,
  "name": "Markbridge · 签桥",
  "version": "0.1.0",
  "description": "Markbridge 本地书签工作台：配对与只读实时同步。",
  "minimum_chrome_version": "134",
  "action": { "default_popup": "index.html", "default_title": "Markbridge · 签桥" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "worker.js", "type": "module" },
  "permissions": ["bookmarks", "storage", "alarms"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*" }
}
